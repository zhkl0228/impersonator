<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.zhkl0228</groupId>
    <artifactId>impersonator</artifactId>
    <packaging>pom</packaging>
    <version>1.6.0</version>
    <modules>
        <module>bctls</module>
        <module>okhttp</module>
        <!-- quic (agent15, kwik) and http3 are here too, in the profiles below; they need a JDK 11 resp. 21. -->
    </modules>

    <profiles>
        <!--
            The quic modules vendor agent15 and kwik, both of which are compiled for Java 11, so
            they cannot be built by the JDK 8 the other two modules target. Keeping them in a profile
            means "mvn install" still works on a JDK 8, it just leaves them out.
        -->
        <profile>
            <id>quic</id>
            <activation>
                <jdk>[11,)</jdk>
            </activation>
            <modules>
                <module>quic</module>
            </modules>
        </profile>
        <!--
            http3 is Java 21, because that is where java.net.http.HttpClient became AutoCloseable and
            the client it hands out owns QUIC connections. One step above the rest, so it gets its own
            activation rather than failing every JDK 11 build.
        -->
        <profile>
            <id>http3</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <modules>
                <module>http3</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.test.skip>false</maven.test.skip>
    </properties>
    <name>impersonator</name>
    <description>Spoof TLS/JA3/JA4 and HTTP/2 fingerprints in Java</description>
    <url>https://github.com/zhkl0228/impersonator</url>
    <licenses>
        <!--
            The quic module links kwik and vendors agent15, both LGPL-3, so the whole project is
            LGPL-3. The BouncyCastle and okhttp code the other modules are forked from is MIT
            resp. Apache-2.0, both of which may be combined into an LGPL-3 work.
        -->
        <license>
            <name>GNU Lesser General Public License v3</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0-standalone.html</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>zhkl0228</name>
            <email>zhkl0228@gmail.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git@github.com:zhkl0228/impersonator.git</connection>
        <developerConnection>scm:git:git@github.com:zhkl0228/impersonator.git</developerConnection>
        <url>git@github.com:zhkl0228/impersonator.git</url>
    </scm>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <additionalOptions>-Xdoclint:none</additionalOptions>
                    <source>8</source>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.10.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>oss</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.19</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-reload4j</artifactId>
            <version>2.0.19</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>2.26.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>2.0.65</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>