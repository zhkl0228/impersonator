<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.zhkl0228</groupId>
    <artifactId>impersonator</artifactId>
    <packaging>pom</packaging>
    <version>1.10.0</version>
    <!--
        All four, unconditionally. They used to be split across profiles activated by JDK version, so
        that "mvn install" would work on a JDK 8 - and the cost of that was a release built on one
        leaving out everything it did not activate, silently. Version 1.7.1 is entirely inside the
        vendored QUIC layer, and a JDK 8 "mvn deploy" would have published it with no change in it at
        all.

        Building now needs a JDK 21, which is what http3 compiles for; see the enforcer below. Using
        the artifacts does not: each module keeps the release it targets, so impersonator-bctls still
        runs on Java 8 and impersonator-kwik on Java 11.
    -->
    <modules>
        <module>bctls</module>
        <module>okhttp</module>
        <module>quic</module>
        <module>http3-core</module>
        <module>http3</module>
    </modules>


    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.test.skip>false</maven.test.skip>
    </properties>
    <name>impersonator</name>
    <description>Spoof TLS/JA3/JA4 and HTTP/2 fingerprints in Java</description>
    <url>https://github.com/zhkl0228/impersonator</url>
    <licenses>
        <!--
            The quic module links kwik and vendors agent15, both LGPL-3, so the whole project is
            LGPL-3. The BouncyCastle and okhttp code the other modules are forked from is MIT
            resp. Apache-2.0, both of which may be combined into an LGPL-3 work.
        -->
        <license>
            <name>GNU Lesser General Public License v3</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0-standalone.html</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>zhkl0228</name>
            <email>zhkl0228@gmail.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git@github.com:zhkl0228/impersonator.git</connection>
        <developerConnection>scm:git:git@github.com:zhkl0228/impersonator.git</developerConnection>
        <url>git@github.com:zhkl0228/impersonator.git</url>
    </scm>
    <build>
        <plugins>
            <!--
                Says which JDK this needs, rather than letting it be found out: on a JDK 8 the first
                sign used to be that half the modules were quietly not there, and on a JDK 11 it is
                http3 failing with "invalid target release: 21" after everything else has been built.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>1.4.1</version>
                <executions>
                    <execution>
                        <id>require-jdk-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>Building impersonator needs a JDK 21 or later, because the http3 module compiles for 21. The artifacts it produces do not: impersonator-bctls targets Java 8 and impersonator-kwik targets 11.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                release rather than source and target, which is not only tidier: with source/target
                the compiler builds against the API of the JDK it is running on, so on a JDK 21 an API
                added after Java 8 compiles happily into a class file marked Java 8 and fails on a
                Java 8 VM with NoSuchMethodError. "bootstrap class path is not set in conjunction with
                -source 8" is javac saying exactly that. release compiles against the release's own
                API, so what each module claims to run on is checked rather than asserted. Modules
                that target something else say so in their own compiler configuration.

                Configured on the plugin and not as the maven.compiler.release property, because the
                javadoc plugin takes that property as its own release and then refuses to run
                alongside -extdirs, which is how okhttp gets its vendored Kotlin classes onto the
                javadoc classpath. The property would make the two mutually exclusive; this does not.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>8</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <additionalOptions>-Xdoclint:none</additionalOptions>
                    <source>8</source>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.10.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>oss</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.19</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-reload4j</artifactId>
            <version>2.0.19</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>2.26.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>2.0.65</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>