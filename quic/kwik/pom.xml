<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.github.zhkl0228</groupId>
        <artifactId>impersonator-quic</artifactId>
        <version>1.10.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <name>kwik</name>
    <artifactId>impersonator-kwik</artifactId>

    <properties>
        <!-- kwik is compiled for Java 11; see UPSTREAM.md. -->
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- kwik is compiled for Java 11; see UPSTREAM.md. -->
                    <release>11</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- Overrides the parent's 8; this module is Java 11. -->
                    <source>11</source>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.github.zhkl0228</groupId>
            <artifactId>impersonator-agent15</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- Used by the vendored kwik. -->
            <groupId>at.favre.lib</groupId>
            <artifactId>hkdf</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <!-- Used by the vendored kwik, for the stateless reset token. -->
            <groupId>com.io7m.repackage.io.whitfin</groupId>
            <artifactId>io.whitfin.siphash</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <!-- Only to drive HTTP/3 in the tests; nothing in main touches it. -->
            <groupId>tech.kwik</groupId>
            <artifactId>flupke</artifactId>
            <version>0.9.4</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <!-- This module vendors kwik; see UPSTREAM.md. -->
                    <groupId>tech.kwik</groupId>
                    <artifactId>kwik</artifactId>
                </exclusion>
                <exclusion>
                    <!-- Vendored too; see ../qpack/UPSTREAM.md. -->
                    <groupId>tech.kwik</groupId>
                    <artifactId>qpack</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- flupke needs it and no longer gets it through kwik. -->
            <groupId>com.github.zhkl0228</groupId>
            <artifactId>impersonator-qpack</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
