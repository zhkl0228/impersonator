<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.github.zhkl0228</groupId>
        <artifactId>impersonator</artifactId>
        <version>1.10.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <name>http3-core</name>
    <artifactId>impersonator-http3-core</artifactId>

    <!--
        An HTTP/3 connection that carries a profile, without java.net.http.HttpClient.

        impersonator-http3 is the adapter that puts one behind java.net.http.HttpClient, and it needs
        a Java 21 for that - HttpClient became AutoCloseable there and nowhere earlier. Everything
        underneath is Java 11, which is what kwik, qpack and flupke are built for, and none of it has
        anything to do with java.net.http: the QUIC handshake, the session tickets and address
        validation tokens, the HTTP/3 SETTINGS, the QPACK dynamic table, the order the field lines go
        out in and the headers the browser adds to every request. Keeping that here means a caller on
        Java 11, or one that wants flupke's connection API rather than HttpClient's, gets all of it.
    -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- Java 11, like kwik and flupke; see the note above. -->
                    <release>11</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- Overrides the parent's 8; this module is Java 11. -->
                    <source>11</source>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.github.zhkl0228</groupId>
            <artifactId>impersonator-kwik</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!--
                flupke is not vendored. It reaches kwik through 13 classes, none of them in a package
                impersonator-kwik differs from upstream in, and this module needs nothing from it that
                is not public. See ../quic/kwik/UPSTREAM.md.
            -->
            <groupId>tech.kwik</groupId>
            <artifactId>flupke</artifactId>
            <version>0.9.4</version>
            <exclusions>
                <exclusion>
                    <groupId>tech.kwik</groupId>
                    <artifactId>kwik</artifactId>
                </exclusion>
                <exclusion>
                    <!-- Vendored too; see ../quic/qpack/UPSTREAM.md. -->
                    <groupId>tech.kwik</groupId>
                    <artifactId>qpack</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!--
                flupke needs it and no longer gets it through kwik. It is vendored because honestly
                advertising Chrome's QPACK settings means implementing the dynamic table upstream does
                not have; see ../quic/qpack/UPSTREAM.md.
            -->
            <groupId>com.github.zhkl0228</groupId>
            <artifactId>impersonator-qpack</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
